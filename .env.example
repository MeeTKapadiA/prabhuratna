# ============================================================
# Prabhuratna Metals — Environment Variables
# ============================================================
# Local: copy this file to `.env` in the project root
# Vercel: Project Settings → Environment Variables (see below)
# ============================================================

# --- Server ---
NODE_ENV=production
PORT=5001

# --- Security (REQUIRED on Vercel / production) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=your_secure_random_jwt_secret_key_here

# --- CORS (REQUIRED on Vercel / production) ---
# Comma-separated frontend URLs that may call the API
# Include your production domain AND any custom domain
ALLOWED_ORIGINS=https://prabhuratna.vercel.app,https://www.your-custom-domain.com

# --- Frontend (optional on Vercel) ---
# Leave UNSET when frontend + API are on the same Vercel project
# (the app already uses relative /api which is rewritten to the serverless function)
# Only set this if the frontend is hosted separately from the API
# VITE_API_URL=https://prabhuratna.vercel.app/api

# --- Database (REQUIRED for production shop data) ---
# On Render: attach a persistent disk and set this to the mount path file.
# Example (matches render.yaml): /var/data/database.sqlite
# Without DB_PATH on serverless/Vercel, SQLite lives in /tmp and is WIPED on redeploy.
# DB_PATH=/var/data/database.sqlite

# --- Superadmin seed (optional; one-time on DB init) ---
# Role cannot be created via UI/API — only via this seed / direct DB access
# SUPERADMIN_USERNAME=superadmin
# SUPERADMIN_EMAIL=superadmin@prabhuratna.local
# SUPERADMIN_PASSWORD=@Meet121603

# ============================================================
# Render API checklist (persistent data)
# ============================================================
# 1. Create Web Service from this repo, Root Directory = backend
# 2. Add Persistent Disk: mount path /var/data, size 1GB+
# 3. Env vars:
#      DB_PATH=/var/data/database.sqlite
#      JWT_SECRET=<strong random>
#      ALLOWED_ORIGINS=https://prabhuratna.in,https://www.prabhuratna.in
# 4. Frontend: set VITE_API_URL=https://YOUR-API.onrender.com/api and rebuild
# 5. Redeploy — products/invoices now survive redeploys
# ============================================================

# ============================================================
# Vercel checklist (frontend / demos only — NOT for live shop DB)
# ============================================================
# 1. JWT_SECRET     = <paste a strong random value>
# 2. ALLOWED_ORIGINS = https://YOUR-PROJECT.vercel.app
# 3. NODE_ENV        = production   (optional; Vercel sets this)
# 4. Do NOT add VITE_API_URL unless API is on a different host
# 5. Optional: SUPERADMIN_USERNAME / SUPERADMIN_EMAIL / SUPERADMIN_PASSWORD
# 6. Redeploy after saving env vars
# ============================================================

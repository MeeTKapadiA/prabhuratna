# Prabhuratna Metals - Environment Variables Configuration

# Server Environment
NODE_ENV=production
PORT=5001

# Security & JWT Configuration
# IMPORTANT: Generate a strong random secret for production (e.g. openssl rand -base64 32)
JWT_SECRET=your_secure_random_jwt_secret_key_here

# CORS Configuration
# Comma-separated list of allowed frontend origins in production
ALLOWED_ORIGINS=https://prabhuratna.vercel.app,http://localhost:3000
